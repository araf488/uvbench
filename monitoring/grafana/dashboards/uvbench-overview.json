{
 "uid": "uvbench-overview",
 "title": "UVBench - capacity, cost & AI",
 "tags": [
  "uvbench"
 ],
 "timezone": "utc",
 "refresh": "30s",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": []
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Cost per hour (USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (tier) (uvbench_cost_per_hour_usd)",
     "legendFormat": "{{tier}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Cost per 1,000 requests (USD)",
