# GPU tier: vcg-a16-6c-60g-16vram (NVIDIA A16 16 GB, 6 vCPU, 60 GB RAM). Day 6 comparison.
TIER=gpu
COST_PER_HOUR=0.471
COMPOSE_EXTRA=compose/docker-compose.gpu.yml
API_WORKERS=3
WEB_REPLICAS=2
PG_POOL_MAX=15
PG_MAX_CONN=200
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE=12GB
REDIS_MAXMEM=1gb
LLM_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_PARALLEL=8
LLM_CTX=12288
LLM_THREADS=4
EMBED_THREADS=2
WHISPER_MODEL=base
STT_THREADS=4
STT_CONCURRENCY=4
AI_CHAT_CONCURRENCY=8
AI_VOICE_CONCURRENCY=4
LLM_CACHE_RAM_MB=1024
