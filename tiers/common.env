# Images: "uvbench" = build on the server; "ghcr.io/<github-user>/uvbench" = pull images built by GitHub Actions
IMAGE_PREFIX=uvbench
IMAGE_TAG=latest
# ---- shared by every tier (bootstrap-target.sh builds .env = common.env + <tier>.env + secrets) ----
LLM_MAX_TOKENS=150
AI_QUEUE_LIMIT=50
EMBED_FILE=nomic-embed-text-v1.5.Q4_K_M.gguf
PIPER_VOICE_FILE=en_US-lessac-medium.onnx
STT_LANGUAGE=
TTS_CONCURRENCY=1
PG_WORK_MEM=8MB
# same dataset on every tier so results are comparable
SEED_USERS=100000
SEED_PRODUCTS=1000000
SEED_ORDERS=500000
SEED_DOCS=2000
