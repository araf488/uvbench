# Tier 2c: vx1-g-2c-8g-120s (2 dedicated vCPU, 8 GB)
TIER=2c
COST_PER_HOUR=0.076
API_WORKERS=2
WEB_REPLICAS=1
PG_POOL_MAX=10
PG_MAX_CONN=100
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
REDIS_MAXMEM=256mb
LLM_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_PARALLEL=2
LLM_CTX=3072
LLM_THREADS=2
EMBED_THREADS=1
WHISPER_MODEL=base
STT_THREADS=2
STT_CONCURRENCY=1
AI_CHAT_CONCURRENCY=2
AI_VOICE_CONCURRENCY=1
# llama.cpp host-RAM prompt cache (MiB). Its default (8192) would not fit the small tiers; same value on 4c/8c keeps results comparable
LLM_CACHE_RAM_MB=512
