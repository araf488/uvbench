# Tier 8c: vx1-g-8c-32g-480s (8 dedicated vCPU, 32 GB) - the 30-day reference instance
# Day 15-21 "max" profile: WHISPER_MODEL=small and LLM_FILE=Qwen2.5-7B-Instruct-Q4_K_M.gguf
TIER=8c
COST_PER_HOUR=0.306
API_WORKERS=6
WEB_REPLICAS=3
PG_POOL_MAX=20
PG_MAX_CONN=300
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE=12GB
REDIS_MAXMEM=1gb
LLM_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_PARALLEL=4
LLM_CTX=6144
LLM_THREADS=8
EMBED_THREADS=2
WHISPER_MODEL=base
STT_THREADS=4
STT_CONCURRENCY=2
AI_CHAT_CONCURRENCY=4
AI_VOICE_CONCURRENCY=2
# llama.cpp host-RAM prompt cache (MiB). Its default (8192) would not fit the small tiers; same value on 4c/8c keeps results comparable
LLM_CACHE_RAM_MB=1024
