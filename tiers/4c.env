# Tier 4c: vx1-g-4c-16g-240s (4 dedicated vCPU, 16 GB)
TIER=4c
COST_PER_HOUR=0.153
API_WORKERS=3
WEB_REPLICAS=2
PG_POOL_MAX=15
PG_MAX_CONN=150
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE=6GB
REDIS_MAXMEM=512mb
LLM_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
LLM_PARALLEL=2
LLM_CTX=3072
LLM_THREADS=4
EMBED_THREADS=2
WHISPER_MODEL=base
STT_THREADS=4
STT_CONCURRENCY=2
AI_CHAT_CONCURRENCY=2
AI_VOICE_CONCURRENCY=2
# llama.cpp host-RAM prompt cache (MiB). Its default (8192) would not fit the small tiers; same value on 4c/8c keeps results comparable
LLM_CACHE_RAM_MB=1024
